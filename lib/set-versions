#
# Writes one version into every package manifest. The four packages are released
# from one git tag, which SwiftPM reads directly, so the manifests carry the same
# text. A leading v on the argument is removed, so the tag v0.3.0 and the manifest
# version 0.3.0 write the same text.
#
# The first heading of flutter/torann/CHANGELOG.md is rewritten. Later headings
# are left as they are. Prose that mentions an older version, including the
# NuGet release notes in Torann.csproj, is left as it is.
#
# Usage: lib/set-versions <version>      e.g. lib/set-versions 0.3.0
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ $# -ne 1 ]]; then
  echo "usage: lib/set-versions <version>" >&2
  exit 1
fi

version="${1#v}"
if [[ -z "$version" || "$version" =~ [[:space:]/\|\&\\] ]]; then
  echo "version must be one token, without a space, slash, backslash, ampersand, or pipe" >&2
  exit 1
fi

require_one() {
  local file="$1" pattern="$2" count
  count="$(grep -E -c "$pattern" "$file" || true)"
  if [[ "$count" -ne 1 ]]; then
    echo "expected one match for /$pattern/ in ${file#"$ROOT"/}, found $count" >&2
    exit 1
  fi
}

rewrite() {
  local file="$1"
  shift
  local tmp
  tmp="$(mktemp)"
  sed "$@" "$file" > "$tmp"
  cat "$tmp" > "$file"
  rm -f "$tmp"
  echo "  set ${file#"$ROOT"/}"
}

csproj="$ROOT/dotnet/src/Torann/Torann.csproj"
kotlin="$ROOT/kotlin/torann/build.gradle.kts"
pubspec="$ROOT/flutter/torann/pubspec.yaml"
podspec="$ROOT/flutter/torann/ios/torann.podspec"
android="$ROOT/flutter/torann/android/build.gradle.kts"
changelog="$ROOT/flutter/torann/CHANGELOG.md"

require_one "$csproj" '<Version>[^<]*</Version>'
require_one "$kotlin" '^version = "'
require_one "$pubspec" '^version: '
require_one "$podspec" '^[[:space:]]*s\.version[[:space:]]*='
require_one "$android" '^version = "'
require_one "$android" 'com\.stonygrey:torann:'

rewrite "$csproj" "s|<Version>[^<]*</Version>|<Version>${version}</Version>|"
rewrite "$kotlin" "s|^version = \".*\"|version = \"${version}\"|"
rewrite "$pubspec" "s|^version: .*|version: ${version}|"
rewrite "$podspec" "s|\(s\.version[[:space:]]*=[[:space:]]*'\)[^']*'|\1${version}'|"
rewrite "$android" \
  -e "s|^version = \".*\"|version = \"${version}\"|" \
  -e "s|com\.stonygrey:torann:[^\"]*|com.stonygrey:torann:${version}|"

tmp="$(mktemp)"
awk -v version="$version" '
  BEGIN { done = 0 }
  /^## / && !done { print "## " version; done = 1; next }
  { print }
  END { if (!done) exit 2 }
' "$changelog" > "$tmp"
cat "$tmp" > "$changelog"
rm -f "$tmp"
echo "  set ${changelog#"$ROOT"/}"

echo "all packages set to version $version"
