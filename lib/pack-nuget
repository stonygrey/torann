# Packs Torann as a Release nupkg into artifacts/.
#
# Usage: lib/pack-nuget
set -euo pipefail
cd "$(dirname "$0")/.."

OUT="$(pwd)/artifacts"
mkdir -p "$OUT"

dotnet pack src/Torann/Torann.csproj -c Release -o "$OUT"

echo "packed:"
ls -1 "$OUT"/Torann.*.nupkg
