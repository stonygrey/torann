{
  "name": "@stonygrey/torann",
  "version": "0.3.1",
  "description": "The Noise Protocol Framework for React Native: native Swift (CryptoKit) and Kotlin (JCA and Bouncy Castle) implementations behind one TypeScript API.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./testing": {
      "types": "./build/testing.d.ts",
      "default": "./build/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "noise-protocol",
    "cryptography",
    "torann"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stonygrey/torann.git",
    "directory": "reactnative/torann"
  },
  "bugs": {
    "url": "https://github.com/stonygrey/torann/issues"
  },
  "author": "Stony Grey LLC <hello@stonygrey.com> (https://stonygrey.com)",
  "license": "MIT",
  "homepage": "https://github.com/stonygrey/torann#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.27",
    "expo-modules-core": "^57.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react-native": "0.86.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
